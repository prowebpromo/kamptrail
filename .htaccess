DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=86400"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self'; font-src 'self' data:; form-action 'self'"
<FilesMatch "\.(html)$|^(manifest\.json|service-worker\.js|release\.json)$">
Header always set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
AddType application/xml .xml
AddType image/x-icon .ico
